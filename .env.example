# Copy to `.env.local` (root) and `packages/web/.env.local` as needed.
# Server-side (used by `fetchPeople` in Server Components)
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=neb

# Client-side (exposed to the browser via Next.js)
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=neb
