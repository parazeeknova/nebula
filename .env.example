# Copy to `.env.local` (root) and `packages/web/.env.local` as needed.
# Server-side (used by `fetchPeople` in Server Components)
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=nebula
HONCHO_API_KEY=
HONCHO_BASE_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=nebula

# OpenAI (second model provider). Put the real key only in `.env.local`.
# Named OPENAI_PROVIDER_* to avoid clashing with any ambient OPENAI_* env.
OPENAI_PROVIDER_API_KEY=
OPENAI_PROVIDER_BASE_URL=https://api.openai.com/v1

# Inference model for agents. `provider::model` refs (e.g. openai::gpt-5.6-luna)
# or a bare id (defaults to GeneralCompute). NEBULA_* override GENERALCOMPUTE_*.
NEBULA_DEFAULT_MODEL=openai::gpt-5.6-luna
NEBULA_FALLBACK_MODEL=openai::gpt-5-nano

# Client-side (exposed to the browser via Next.js)
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=nebula

# Nodemailer feedback (Gmail sender). SMTP_USER is your Gmail address and
# SMTP_PASS is a Gmail "App Password" (16-char, no spaces). Put real values
# only in `.env.local`.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
