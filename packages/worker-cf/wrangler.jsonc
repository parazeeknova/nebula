{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nebula-agent-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_POLLER",
        "class_name": "QueuePoller",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueuePoller"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "SPACETIMEDB_HOST": "https://maincloud.spacetimedb.com",
    "SPACETIMEDB_DB": "nebula",
  },
}
