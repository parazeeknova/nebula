{
  "name": "@nebula/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "openai": "^4.0.0",
    "spacetimedb": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "bun-types": "^1.4.2",
    "typescript": "7.0.2"
  }
}
