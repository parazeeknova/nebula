# General Compute (OpenAI-compatible; primary model with Gemma fallback)
GENERALCOMPUTE_API_KEY=
GENERALCOMPUTE_BASE_URL=https://api.generalcompute.com/v1
GENERALCOMPUTE_MODEL=gpt-oss-120b
GENERALCOMPUTE_FALLBACK_MODEL=gemma-4-31B-it

# Firecrawl (web search agent)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# SpacetimeDB (frontend + worker share this database)
# Local dev:    SPACETIMEDB_HOST=ws://127.0.0.1:3000
# Maincloud:    SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=nebula
# Identity token for the worker/seed (spacetime login) — empty uses anonymous
SPACETIMEDB_TOKEN=

# Worker loop
WORKER_POLL_MS=1000

# API server
PORT=3002
