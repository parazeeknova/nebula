{
  "name": "nebula",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "lerna run dev --scope @nebula/web --stream",
    "dev:all": "lerna run dev --stream",
    "build": "lerna run build --stream",
    "start": "lerna run start --scope @nebula/web --stream",
    "worker": "lerna run worker --scope @nebula/web --stream",
    "seed": "lerna run seed --scope @nebula/web --stream",
    "generate": "lerna run generate --stream",
    "check": "oxfmt --write && oxlint --fix-dangerously",
    "check-types": "lerna run typecheck --stream",
    "test": "lerna run test --stream",
    "prepare": "lefthook install",
    "spacetime:publish:local": "bun --filter @nebula/spacetimedb run publish:local",
    "spacetime:publish": "bun --filter @nebula/spacetimedb run publish"
  },
  "devDependencies": {
    "lefthook": "2.1.12",
    "lerna": "10.0.1",
    "lint-staged": "17.5.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
